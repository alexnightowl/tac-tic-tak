DATABASE_URL=postgresql://taktic:taktic@localhost:5432/taktic?schema=public
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
PORT=4000
LICHESS_PUZZLE_URL=https://database.lichess.org/lichess_db_puzzle.csv.zst
DATA_DIR=./data

# Mobile app config (GET /api/v1/app-config) and the 426 min-build gate.
# All optional; unset = no gate / null / no flags. Docker: add each one to
# the backend `environment:` block in docker-compose.yml to pass it through.
# MIN_SUPPORTED_BUILD_IOS=0
# MIN_SUPPORTED_BUILD_ANDROID=0
# LATEST_BUILD_IOS=
# LATEST_BUILD_ANDROID=
# APP_STORE_URL=
# PLAY_STORE_URL=
# FEATURE_FLAGS=flagA,-flagB        (or JSON: {"flagA":true,"flagB":false})
# MAINTENANCE_MESSAGE=

# Rate limits (B11, src/throttle/throttle.config.ts). Defaults apply when unset.
# Local dev/Maestro runs that register many accounts from one IP can raise a
# limit or switch the guard off; prod needs none of these.
# THROTTLE_ENABLED=false
# THROTTLE_REGISTER_LIMIT=1000
# THROTTLE_LOGIN_IP_LIMIT=5          (any throttler: THROTTLE_<NAME>_LIMIT / _TTL_SEC)
